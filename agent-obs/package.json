{
  "name": "knr-agent-obs",
  "productName": "Agent OBS KNR",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "legacy:start": "node index.js",
    "service:start": "pm2 start ecosystem.config.js",
    "service:stop": "pm2 stop agent-obs",
    "service:logs": "pm2 logs agent-obs",
    "service:save": "pm2 save"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "obs-websocket-js": "^5.0.3",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "bj.knr.agentobs",
    "productName": "Agent OBS KNR",
    "files": [
      "main.js",
      "preload.js",
      "obsBridge.js",
      "configStore.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
