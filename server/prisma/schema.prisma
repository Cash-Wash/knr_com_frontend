generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  PRESENTER
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum ReunionStatus {
  SCHEDULED
  IN_PROGRESS
  ENDED
}

enum ProgrammeStatus {
  SCHEDULED
  CURRENT
  PAST
}

enum StudioBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  active    Boolean  @default(true)
  phone     String?
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emissions Emission[]
  articles   BlogArticle[]
  reunions   Reunion[]
  lives      Live[]
  programmeItems ProgrammeItem[]

  @@map("users")
}

model Live {
  id         String     @id @default(cuid())
  titre      String
  youtubeUrl String?
  youtubeId  String?
  status     LiveStatus @default(SCHEDULED)
  viewers    Int        @default(0)
  programme  String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdBy  String?
  creator    User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("lives")
}

model Emission {
  id          String        @id @default(cuid())
  titre       String
  slug        String        @unique
  sousTitre   String?
  categorie   String?
  animateur   String?
  duree       String?
  tags        Json?
  description String?       @db.LongText
  thumbnail   String?
  youtubeUrl  String?
  views       Int           @default(0)
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  episodes    Episode[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("emissions")
}

model Episode {
  id         String   @id @default(cuid())
  emissionId String
  emission   Emission @relation(fields: [emissionId], references: [id], onDelete: Cascade)
  titre      String?
  youtubeUrl String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("episodes")
}

model Entrepreneur {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.LongText
  photo     String?
  socials   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entrepreneurs")
}

model BlogArticle {
  id          String        @id @default(cuid())
  titre       String
  slug        String        @unique
  excerpt     String?       @db.LongText
  readTime    String?
  featured    Boolean       @default(false)
  content     String        @db.LongText
  thumbnail   String?
  category    String?
  status      ContentStatus @default(DRAFT)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("blog_articles")
}

model TeamMember {
  id        String        @id @default(cuid())
  name      String
  poste     String
  bio       String?       @db.LongText
  photo     String?
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("team_members")
}

model AppSettings {
  id               String   @id @default("singleton")
  siteName         String?
  siteTagline      String?
  youtubeApiKey    String?
  youtubeChannelId String?
  agentObsToken    String?
  obsWsPort        String?
  obsWsPassword    String?
  updatedAt        DateTime @updatedAt

  @@map("app_settings")
}

model ProgrammeItem {
  id          String          @id @default(cuid())
  heure       String
  titre       String
  description String?         @db.LongText
  statut      ProgrammeStatus @default(SCHEDULED)
  date        DateTime        @default(now())
  createdBy   String?
  creator     User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("programme_items")
}

model Reunion {
  id           String        @id @default(cuid())
  titre        String
  description  String?       @db.LongText
  scheduledAt  DateTime
  hostId       String
  host         User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  status       ReunionStatus @default(SCHEDULED)
  assignedUserIds Json?
  roomSlug     String?       @unique
  accessCode   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("reunions")
}

model Formation {
  id                      String        @id @default(cuid())
  slug                    String        @unique
  titre                   String
  categorie               String
  sousTitre               String?
  description             String?       @db.LongText
  prix                    String?
  duree                   String?
  niveau                  String?
  lieu                    String?
  debut                   String?
  fin                     String?
  placesRestantes         Int           @default(0)
  joursClotureInscription Int           @default(0)
  clotureInscriptions     DateTime?
  img                     String?
  competences             Json?
  modules                 Json?
  formateurNom            String?
  formateurTitre          String?
  formateurBio            String?       @db.LongText
  formateurPhoto          String?
  status                  ContentStatus @default(DRAFT)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@map("formations")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String   @db.LongText
  status      String   @default("NEW")
  assignedTo  String?
  context     String?
  contextId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_messages")
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  category    String?
  status      String   @default("AVAILABLE")
  description String?  @db.LongText
  location    String?
  image       String?
  tarifJour   Int?
  caution     String?
  images      Json?
  specs       Json?
  conditions  Json?
  reservedDates Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("equipment")
}

model StudioBooking {
  id          String              @id @default(cuid())
  date        String
  heure       String?
  forfait     String
  typeProjet  String?
  prenom      String
  nom         String
  email       String
  telephone   String
  entreprise  String?
  description String?             @db.LongText
  modePaiement String?
  reference   String              @unique
  status      StudioBookingStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("studio_bookings")
}
